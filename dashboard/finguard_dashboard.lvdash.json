{
  "datasets": [
    {
      "name": "transactions",
      "displayName": "Transactions",
      "queryLines": [
        "SELECT\n",
        "  transaction_id,\n",
        "  customer_id,\n",
        "  card_number,\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  amount,\n",
        "  currency,\n",
        "  transaction_type,\n",
        "  payment_channel,\n",
        "  city,\n",
        "  country,\n",
        "  transaction_timestamp,\n",
        "  is_international,\n",
        "  status\n",
        "FROM\n",
        "  finguard.silver.transactions"
      ]
    },
    {
      "name": "combined_alerts",
      "displayName": "Combined Alerts",
      "queryLines": [
        "SELECT\n",
        "  fca.alert_id,\n",
        "  fca.alert_type,\n",
        "  fca.transaction_id,\n",
        "  fca.customer_id,\n",
        "  fca.customer_name,\n",
        "  fca.card_number,\n",
        "  fca.amount,\n",
        "  fca.currency,\n",
        "  fca.merchant_name,\n",
        "  fca.merchant_category,\n",
        "  fca.transaction_type,\n",
        "  fca.payment_channel,\n",
        "  fca.transaction_city AS city,\n",
        "  fca.transaction_country AS country,\n",
        "  fca.transaction_timestamp,\n",
        "  fca.is_international,\n",
        "  fca.transaction_status AS status,\n",
        "  fca.risk_level,\n",
        "  fca.action,\n",
        "  fca.reason_description\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert fca\n",
        "UNION ALL\n",
        "SELECT\n",
        "  hta.alert_id,\n",
        "  hta.alert_type,\n",
        "  hta.transaction_id,\n",
        "  hta.customer_id,\n",
        "  hta.customer_name,\n",
        "  NULL AS card_number,\n",
        "  hta.transaction_amount AS amount,\n",
        "  hta.currency,\n",
        "  hta.merchant_name,\n",
        "  hta.merchant_category,\n",
        "  hta.transaction_type,\n",
        "  hta.payment_channel,\n",
        "  hta.city,\n",
        "  hta.country,\n",
        "  hta.transaction_timestamp,\n",
        "  hta.is_international,\n",
        "  hta.status,\n",
        "  NULL AS risk_level,\n",
        "  NULL AS action,\n",
        "  NULL AS reason_description\n",
        "FROM\n",
        "  finguard.gold.high_value_transactions_alert hta"
      ]
    },
    {
      "name": "kpi_total_transactions",
      "displayName": "KPI: Total Transactions",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS metric_value\n",
        "FROM\n",
        "  finguard.silver.transactions"
      ]
    },
    {
      "name": "kpi_total_value",
      "displayName": "KPI: Total Transaction Value",
      "queryLines": [
        "SELECT\n",
        "  SUM(amount) AS metric_value\n",
        "FROM\n",
        "  finguard.silver.transactions"
      ]
    },
    {
      "name": "kpi_total_alerts",
      "displayName": "KPI: Total Alerts",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS metric_value\n",
        "FROM\n",
        "  (\n",
        "    SELECT\n",
        "      alert_id\n",
        "    FROM\n",
        "      finguard.gold.fraud_card_alert\n",
        "    UNION ALL\n",
        "    SELECT\n",
        "      alert_id\n",
        "    FROM\n",
        "      finguard.gold.high_value_transactions_alert\n",
        "  ) combined"
      ]
    },
    {
      "name": "kpi_high_risk_alerts",
      "displayName": "KPI: High-Risk Alerts",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS metric_value\n",
        "FROM\n",
        "  finguard.gold.fraud_card_alert\n",
        "WHERE\n",
        "  risk_level IN ('HIGH', 'CRITICAL')"
      ]
    },
    {
      "name": "kpi_unique_customers",
      "displayName": "KPI: Unique Customers",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS metric_value\n",
        "FROM\n",
        "  finguard.silver.customers"
      ]
    },
    {
      "name": "kpi_alert_rate",
      "displayName": "KPI: Fraud Alert Rate",
      "queryLines": [
        "SELECT\n",
        "  ROUND(\n",
        "    (\n",
        "      (\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          finguard.gold.fraud_card_alert\n",
        "      )\n",
        "        + (\n",
        "          SELECT\n",
        "            COUNT(*)\n",
        "          FROM\n",
        "            finguard.gold.high_value_transactions_alert\n",
        "        )\n",
        "    )\n",
        "      * 100.0\n",
        "      / (\n",
        "        SELECT\n",
        "          COUNT(*)\n",
        "        FROM\n",
        "          finguard.silver.transactions\n",
        "      ),\n",
        "    2\n",
        "  ) AS metric_value"
      ]
    }
  ],
